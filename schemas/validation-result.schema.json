{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligence-platform.local/schemas/validation-result.schema.json",
  "title": "Hypothesis Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_run_id",
    "workspace_id",
    "hypothesis_id",
    "status",
    "result",
    "confidence",
    "summary",
    "dimensions",
    "evidence",
    "limitations",
    "unresolved_questions",
    "source_cutoff_at",
    "engine_version",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "validation_run_id": {"$ref": "#/$defs/uuid"},
    "workspace_id": {"$ref": "#/$defs/uuid"},
    "hypothesis_id": {"$ref": "#/$defs/uuid"},
    "status": {"enum": ["completed", "partial"]},
    "result": {"enum": ["supported", "mixed", "weakened", "inconclusive"]},
    "confidence": {"$ref": "#/$defs/score"},
    "summary": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "status", "conclusion", "confidence"],
        "properties": {
          "dimension": {"enum": ["competitor", "demand", "adoption", "funding", "technical", "regulatory", "incumbent", "failed_attempt", "counter_signal"]},
          "status": {"enum": ["completed", "partial", "not_applicable", "failed"]},
          "conclusion": {"type": ["string", "null"]},
          "confidence": {"oneOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "dimension", "stance", "weight", "reasoning_summary"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/uuid"},
          "dimension": {"enum": ["competitor", "demand", "adoption", "funding", "technical", "regulatory", "incumbent", "failed_attempt", "counter_signal"]},
          "stance": {"enum": ["supporting", "contradicting", "neutral"]},
          "weight": {"$ref": "#/$defs/score"},
          "reasoning_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "source_cutoff_at": {"$ref": "#/$defs/dateTime"},
    "engine_version": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "dateTime": {"type": "string", "format": "date-time"},
    "score": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
