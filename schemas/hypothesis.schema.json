{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligence-platform.local/schemas/hypothesis.schema.json",
  "title": "Opportunity Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "workspace_id",
    "workspace_domain_id",
    "title",
    "statement",
    "target_user",
    "problem",
    "proposed_value",
    "assumptions",
    "origin",
    "status",
    "confidence",
    "pattern_links",
    "supporting_evidence_ids",
    "counter_evidence_ids",
    "engine_version",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "hypothesis_id": {"$ref": "#/$defs/uuid"},
    "workspace_id": {"$ref": "#/$defs/uuid"},
    "workspace_domain_id": {"$ref": "#/$defs/uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "target_user": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "proposed_value": {"type": ["string", "null"]},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "critical", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "status": {"enum": ["untested", "supported", "mixed", "weakened", "inconclusive"]}
        }
      }
    },
    "origin": {"enum": ["user", "engine", "mixed"]},
    "status": {"enum": ["draft", "ready_for_validation", "validating", "supported", "mixed", "weakened", "inconclusive", "archived"]},
    "confidence": {"$ref": "#/$defs/score"},
    "pattern_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "role", "weight"],
        "properties": {
          "pattern_id": {"$ref": "#/$defs/uuid"},
          "role": {"enum": ["primary", "supporting", "contradicting", "context"]},
          "weight": {"$ref": "#/$defs/score"}
        }
      }
    },
    "supporting_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "counter_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "engine_version": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "score": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
