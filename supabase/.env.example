# Browser-safe connection values. Obtain them from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server and n8n only. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=SET_ONLY_IN_THE_SERVER_OR_N8N_CREDENTIAL_STORE

