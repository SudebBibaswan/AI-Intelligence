# ============================================
# AI Intelligence Platform - Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# ============================================
# SUPABASE (Required)
# Get from: Supabase Dashboard → Settings → API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for server-side operations (admin APIs, n8n)
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# N8N CLOUD (Required for workflow triggers)
# Get from: n8n Cloud Dashboard → Workflows → Webhook node → Production URL
# Format: https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/WORKFLOW_PATH
# ============================================
# Single secret for ALL 16 webhooks (set in each Webhook node → Header Auth → Authorization: Bearer YOUR_SECRET)
N8N_WEBHOOK_SECRET=your-single-webhook-secret-for-all-workflows

# ============================================
# N8N WEBHOOK URLs (16 workflows - separate URLs, single secret)
# Get from: n8n Cloud Dashboard → Workflows → Webhook node → Production URL
# Format: https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/WORKFLOW_PATH
# ============================================

# Core Analytical Pipeline (7 workflows)
# RE01 - Research Engine V2 (multi-source evidence collection)
N8N_WEBHOOK_RESEARCH_ENGINE=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/research-engine-v2

# RE07 - Signal Engine (evidence → signals)
N8N_WEBHOOK_SIGNAL=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/signal-engine

# RE08 - Observation Engine (signals → observations)
N8N_WEBHOOK_OBSERVATION=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/observation-engine

# RE09 - Pattern Engine (observations → patterns)
N8N_WEBHOOK_PATTERN=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/pattern-engine

# RE-Thesis - Thesis Engine (patterns → stated/revealed thesis)
N8N_WEBHOOK_THESIS=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/thesis-engine

# RE-Capital - Capital Flow Engine (patterns + theses → capital flow mappings)
N8N_WEBHOOK_CAPITAL=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/capital-flow-engine

# RE10 - Hypothesis Engine (patterns → hypotheses)
N8N_WEBHOOK_HYPOTHESIS=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/hypothesis-engine

# RE11 - Validation Engine (hypotheses → adversarial validation)
N8N_WEBHOOK_VALIDATION=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/validation-engine

# Infrastructure / Maintenance (4 workflows)
# RE05 - Quality Engine (research quality snapshots)
N8N_WEBHOOK_QUALITY=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/quality-engine

# RE14 - Evidence Review Engine (evidence review queue)
N8N_WEBHOOK_EVIDENCE_REVIEW=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/evidence-review-engine

# RE02 - Shared Domain Scheduler (per-domain collection scheduling)
N8N_WEBHOOK_SCHEDULER=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/shared-domain-scheduler

# RE06 - Capital Directory Refresh (entity registry maintenance)
N8N_WEBHOOK_CAPITAL_DIR_REFRESH=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/capital-directory-refresh

# Capital / Entity Registry (3 workflows)
# RE06 - Capital Entity Registry
N8N_WEBHOOK_CAPITAL_ENTITY_REGISTRY=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/capital-entity-registry

# RE13 - Capital Profile Verification
N8N_WEBHOOK_CAPITAL_PROFILE_VERIFICATION=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/capital-profile-verification

# RE12 - SEBI Capital Registry
N8N_WEBHOOK_SEBI_CAPITAL_REGISTRY=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/sebi-capital-registry

# Legacy / Ad-hoc (1 workflow)
# RE04 - Evidence Backfill
N8N_WEBHOOK_EVIDENCE_BACKFILL=https://YOUR_SUBDOMAIN.app.n8n.cloud/webhook/evidence-backfill

# ============================================
# OPENAI (Required for n8n workflows)
# Get from: OpenAI Dashboard → API Keys
# Used by n8n workflows for LLM calls
# ============================================
OPENAI_API_KEY=your-openai-key

# ============================================
# RESEARCH PROVIDERS (Required for Research Engine V2)
# ============================================
# Tavily - Web search API
# Get from: Tavily Dashboard → API Keys
TAVILY_API_KEY=your-tavily-key

# Firecrawl - Web extraction API
# Get from: Firecrawl Dashboard → API Keys
FIRECRAWL_API_KEY=your-firecrawl-key

# ============================================
# OPTIONAL: Additional Research Providers
# ============================================
# GDELT - Global event database (free)
# GDELT_API_KEY=your-gdelt-key

# SerpAPI - Google search (alternative to Tavily)
# SERPAPI_KEY=your-serpapi-key

# ============================================
# N8N CREDENTIALS (Set in n8n Cloud → Credentials)
# NOT in .env - configure directly in n8n Cloud UI
# ============================================
# Supabase Credential: type "Supabase API" with URL + Service Role Key
# OpenAI Credential: type "OpenAI API" with API Key
# Tavily Credential: type "Tavily API" with API Key
# Firecrawl Credential: type "Firecrawl API" with API Key

# ============================================
# OPTIONAL: Frontend-only keys
# ============================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=Intelligence Platform

# ============================================
# QUICK START CHECKLIST
# ============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in Supabase URL + Anon Key (required)
# 3. Fill in Supabase Service Role Key (required for server APIs)
# 4. Fill in n8n Cloud webhook URLs (16 workflows: RE01-RE14 + RE-Thesis + RE-Capital)
# 5. Fill in N8N_WEBHOOK_SECRET (single secret for all webhooks)
# 6. In n8n Cloud: each Webhook node → Authentication → Header Auth → Authorization: Bearer YOUR_N8N_WEBHOOK_SECRET
# 7. Fill in OpenAI API Key
# 8. Fill in Tavily + Firecrawl API Keys
# 9. Run: pnpm dev
# 10. Visit http://localhost:3000
# 11. Login → Create workspace → Select domain → Run Research Engine V2