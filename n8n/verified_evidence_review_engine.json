    {
      "id": "16056a0b-0000-4000-8000-4ff627bd8e37",
      "name": "Process Review Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Review Engine Configuration').first().json;\nconst queue = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json])\n  .filter(r => r.workspace_id === config.workspace_id);\nconst eligible = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json])\n  .filter(r => r.workspace_id === config.workspace_id);\nconst capital = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json])\n  .filter(r => r.workspace_id === config.workspace_id);\n\nconst pendingReview = queue.length;\nconst highConfidencePending = queue.filter(r => Number(r.confidence || 0) >= 0.8).length;\nconst disputedCount = queue.filter(r => r.verification_status === 'disputed').length;\nconst signalReady = eligible.length;\n\nconst capitalActive = capital.filter(c => c.activity_status === 'active_evidenced').length;\nconst capitalEvidenced = capital.filter(c => c.activity_status === 'evidenced').length;\nconst capitalCandidates = capital.filter(c => c.activity_status === 'candidate_unverified').length;\n\nreturn [{ json: {\n  config,\n  review_queue: queue.slice(0, 20),\n  summary: {\n    pending_review: pendingReview,\n    high_confidence_pending: highConfidencePending,\n    disputed_count: disputedCount,\n    signal_ready_evidence: signalReady,\n    capital_active_evidenced: capitalActive,\n    capital_evidenced: capitalEvidenced,\n    capital_candidates: capitalCandidates,\n  },\n} }];"
      }
    },
    {
      "id": "5e7d55f7-0000-4000-8000-2e5f3dbfcab6",
      "name": "Has Pending Reviews?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b19b3176-0000-4000-8000-3ab267b8b66d",
              "leftValue": "={{ $json.summary.pending_review > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a754177e-0000-4000-8000-751ff5ed96a8",
      "name": "Review Queue Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $('Process Review Queue').item.json;\nreturn [{ json: { status: 'completed',\n  pending_reviews: data.summary.pending_review,\n  high_confidence: data.summary.high_confidence_pending,\n  disputed: data.summary.disputed_count,\n  signal_ready: data.summary.signal_ready_evidence,\n  capital_active: data.summary.capital_active_evidenced,\n  capital_evidenced: data.summary.capital_evidenced,\n  capital_candidates: data.summary.capital_candidates,\n  note: 'Evidence review queue processed. Frontend can query v_evidence_review_queue for actionable items. Capital directory available in v_capital_directory.' } }];"
      }
    },
